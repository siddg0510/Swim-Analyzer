# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs
.venv/
venv/
env/

# PyInstaller build output
build/
dist/
*.manifest

# Claude Code scratch worktrees
.claude/worktrees/

# Runtime data: user-uploaded race videos and job scratch space.
# Never commit race footage — see the retention policy in web/storage.py.
data/uploads/
data/jobs/

# Local tracking-regression fixtures. Real footage of identifiable swimmers;
# kept out of git for privacy and size. Regenerate from your own clip — see
# tests/fixtures/README.md.
data/testclips/

# Synthetic placeholder DTW templates generated by
# scripts/create_placeholder_templates.py. These are sinusoidal stand-ins,
# NOT real elite footage — regenerate locally rather than committing them.
data/olympic_gold/*.npy

# OS cruft
.DS_Store
Thumbs.db
